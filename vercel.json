{
  "rewrites": [
    {
      "source": "/home-charging",
      "destination": "/home-charging/index.html"
    },
    {
      "source": "/home-charging/",
      "destination": "/home-charging/index.html"
    }
  ],
  "headers": [
    {
      "source": "/home-charging/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
