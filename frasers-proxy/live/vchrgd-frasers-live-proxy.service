[Unit]
Description=VCHRGD Frasers Plus live API proxy for staging validation
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/opt/vchrgd-frasers-live-proxy
EnvironmentFile=/etc/vchrgd-frasers-live-proxy.env
ExecStart=/usr/bin/node /opt/vchrgd-frasers-live-proxy/server.mjs
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
